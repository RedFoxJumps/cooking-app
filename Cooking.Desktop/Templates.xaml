<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dish="clr-namespace:Cooking.Desktop.DishArea"
                    xmlns:models="clr-namespace:Cooking.Contracts.Models;assembly=Cooking.Contracts"
                    xmlns:menu="clr-namespace:Cooking.Desktop.MenuArea"
                    xmlns:shared="clr-namespace:Cooking.Desktop.Shared"
                >

    <DataTemplate DataType="{x:Type dish:DishEditorViewModel}">
        <dish:DishEditorView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dish:CatalogueViewModel}">
        <dish:CatalogueView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type menu:MenuHistoryViewModel}">
        <menu:MenuHistoryView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type menu:NewMenuViewModel}">
        <menu:NewMenuView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type shared:OkCancelViewModel}">
        <shared:OkCancelView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:Dish}">
        <dish:DishView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dish:TagButtonViewModel}">
        <dish:TagButtonView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dish:TagInputViewModel}">
        <dish:TagInputView />
    </DataTemplate>
    
</ResourceDictionary>