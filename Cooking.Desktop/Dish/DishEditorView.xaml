<Window x:Class="Cooking.Desktop.DishArea.DishEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Cooking.Desktop.DishArea"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800"
        d:DataContext="{d:DesignInstance local:DishEditorViewModel}"
        ResizeMode="CanResizeWithGrip"
        >
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="0.25*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical">
                <TextBlock Text="{DynamicResource Name}" />
                <TextBox Text="{Binding DishName}" AcceptsReturn="False" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <TextBlock Text="{DynamicResource Description}" />
                <TextBox Text="{Binding DishDescription}" AcceptsReturn="True" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="{DynamicResource AppliedTags}" Background="LightCyan">
                    <ItemsControl ItemsSource="{Binding AppliedTags}" Padding="5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="{DynamicResource AllTags}" Background="LightPink">
                    <ItemsControl ItemsSource="{Binding ExistingTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </GroupBox>

            </Grid>
        </Grid>
        
        <ContentControl Grid.Row="1"
                        Margin="5"
                        HorizontalAlignment="Right"
                        Content="{Binding OkCancelViewModel}" />
    </Grid>
</Window>
