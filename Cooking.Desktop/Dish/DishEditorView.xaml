<Window x:Class="Cooking.Desktop.DishArea.DishEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Cooking.Desktop.DishArea"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800"
        d:DataContext="{d:DesignInstance local:DishEditorViewModel}"
        >
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical">
                <TextBlock Text="{DynamicResource Name}" />
                <TextBox Text="{Binding DishName}" AcceptsReturn="False" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <TextBlock Text="{DynamicResource Description}" />
                <TextBox Text="{Binding DishDescription}" AcceptsReturn="True" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <ItemsControl ItemsSource="{Binding CurrentTags}" Grid.Column="0" />
                <ItemsControl Grid.Column="1" />

            </Grid>
        </Grid>
        
        <ContentControl Grid.Row="1"
                        Margin="5"
                        HorizontalAlignment="Right"
                        Content="{Binding OkCancelViewModel}" />
    </Grid>
</Window>
